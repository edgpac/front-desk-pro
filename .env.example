# Copy this file to .env and fill in real values to run everything locally.

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Create a project at https://supabase.com/dashboard (use a NEW project —
# don't reuse one from another app, FrontDesk's users should be its own).
# Settings -> API on that project gives you the URL and the anon/publishable key.
# VITE_-prefixed vars are exposed to the browser; the plain ones are for
# server-side code (src/integrations/supabase/auth-middleware.ts) and should
# hold the same values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
