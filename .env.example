# Copy this file to .env and fill in real values to run everything locally.

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Create a project at https://supabase.com/dashboard (use a NEW project —
# don't reuse one from another app, FrontDesk's users should be its own).
# Settings -> API on that project gives you the URL and the anon/publishable key.
# VITE_-prefixed vars are exposed to the browser; the plain ones are for
# server-side code (src/integrations/supabase/auth-middleware.ts) and should
# hold the same values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Same Supabase project as above, but the SERVICE ROLE key (Settings -> API
# -> service_role, "secret" — never expose this to the browser). Used
# server-side by the Stripe webhook (to record a paid plan on a user) and by
# src/lib/public-lead-server.ts (to save a lead on a tenant's behalf when an
# anonymous customer submits one — they have no Supabase session of their own).
SUPABASE_SERVICE_ROLE_KEY=

# Sends the "new lead" notification email (src/lib/notify-server.ts), ported
# from Cabos Handyman's own working pattern: a Gmail account + an App
# Password (not your normal password — generate one at
# https://myaccount.google.com/apppasswords, requires 2FA enabled on the
# account). NOTIFICATION_FROM_EMAIL is the Gmail address that sends; each
# tenant's own tenants.email is who receives.
NOTIFICATION_FROM_EMAIL=
EMAIL_APP_PASSWORD=

# From https://dashboard.stripe.com/apikeys (use the *test* keys while
# developing). STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you
# create at https://dashboard.stripe.com/webhooks, pointed at
# <your-deployed-url>/api/stripe/webhook — Stripe CLI's `stripe listen` gives
# you a temporary one for local testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build the Stripe success/cancel redirect URLs. Your deployed URL in
# production; localhost is fine while developing.
SITE_URL=http://localhost:8080

# WhatsApp intake channel (src/routes/api.whatsapp.webhook.tsx), via Twilio
# rather than applying to Meta directly as an independent Tech Provider —
# Twilio acts as the verified intermediary and is a faster on-ramp. Get these
# from https://console.twilio.com after enabling WhatsApp on a Twilio number.
# TWILIO_WHATSAPP_NUMBER is Twilio's own number in "whatsapp:+1..." form —
# for now, one shared number routes to a tenant via their tenants.whatsapp_number
# column (set manually until there's a "Connect WhatsApp" onboarding flow).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
